rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.phone_number in ['+918754344229', '+919659650202'] &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /products/{imageName} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /paymentEvidence/{uid}/{orderId}/proof {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid &&
          firestore.get(/databases/(default)/documents/orders/$(orderId)).data.uid == uid;
      }
      allow read: if isAdmin() || isOwner();
      allow create, update: if isOwner() &&
        firestore.get(/databases/(default)/documents/orders/$(orderId)).data.status == 'payment_pending' &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png)|application/pdf');
      allow delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
