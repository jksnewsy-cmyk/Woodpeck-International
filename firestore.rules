rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedAdminPhone() {
      return request.auth != null &&
        request.auth.token.phone_number in ['+918754344229', '+919659650202'];
    }
    function isAdmin() {
      return approvedAdminPhone() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if approvedAdminPhone() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /products/{productId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['name','category','description','materials','tag','price','compareAt','stock','image','images','variantGroup','finish','configuration','published','bestseller','updatedAt','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120 &&
        request.resource.data.category in ['sofas','chairs','tables','beds','wardrobes','decor'] &&
        request.resource.data.description is string && request.resource.data.description.size() <= 3000 &&
        request.resource.data.materials is string && request.resource.data.materials.size() <= 300 &&
        request.resource.data.tag is string && request.resource.data.tag.size() <= 60 &&
        request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 10000000 &&
        request.resource.data.compareAt is number && request.resource.data.compareAt >= 0 && request.resource.data.compareAt <= 10000000 &&
        request.resource.data.stock is int && request.resource.data.stock >= 0 && request.resource.data.stock <= 100000 &&
        request.resource.data.image is string && request.resource.data.image.size() <= 2000 &&
        (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 9)) &&
        (!('variantGroup' in request.resource.data) || (request.resource.data.variantGroup is string && request.resource.data.variantGroup.size() <= 80)) &&
        (!('finish' in request.resource.data) || (request.resource.data.finish is string && request.resource.data.finish.size() <= 80)) &&
        (!('configuration' in request.resource.data) || (request.resource.data.configuration is string && request.resource.data.configuration.size() <= 80)) &&
        request.resource.data.published is bool && request.resource.data.bestseller is bool;
      allow delete: if isAdmin();
    }
    // Server-only payment records. A customer may view only their own order.
    // Client-side UTR submission and admin payment approval are disabled:
    // callable server functions validate transitions and inventory.
    match /orders/{orderId} {
      allow get: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /paymentReferences/{referenceId} {
      allow read, write: if false;
    }
    // Each verified customer can access only their own saved address documents.
    match /customers/{uid}/addresses/{addressId} {
      function ownAddress() {
        return request.auth != null && request.auth.uid == uid &&
          request.auth.token.phone_number is string;
      }
      allow get, list, delete: if ownAddress();
      allow create, update: if ownAddress() &&
        request.resource.data.keys().hasOnly(['name','phone','line1','line2','city','state','pin','label','updatedAt']) &&
        request.resource.data.keys().hasAll(['name','phone','line1','line2','city','state','pin','label','updatedAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$') &&
        request.resource.data.line1 is string && request.resource.data.line1.size() >= 5 && request.resource.data.line1.size() <= 150 &&
        request.resource.data.line2 is string && request.resource.data.line2.size() <= 100 &&
        request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 70 &&
        request.resource.data.state is string && request.resource.data.state.size() >= 2 && request.resource.data.state.size() <= 70 &&
        request.resource.data.pin is string && request.resource.data.pin.matches('^[1-9][0-9]{5}$') &&
        request.resource.data.label in ['Home','Work','Other'] &&
        request.resource.data.updatedAt == request.time;
    }
    match /settings/bankTransfer {
      allow get: if isAdmin() || (request.auth != null && request.auth.token.phone_number is string && resource.data.enabled == true);
      allow list, delete: if false;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['enabled','bankName','accountName','accountNumber','ifsc','updatedAt']) &&
        request.resource.data.keys().hasAll(['enabled','bankName','accountName','accountNumber','ifsc','updatedAt']) &&
        request.resource.data.enabled is bool &&
        request.resource.data.bankName is string && request.resource.data.bankName.size() >= 2 && request.resource.data.bankName.size() <= 100 &&
        request.resource.data.accountName is string && request.resource.data.accountName.size() >= 2 && request.resource.data.accountName.size() <= 100 &&
        request.resource.data.accountNumber is string && request.resource.data.accountNumber.matches('^[0-9]{8,20}$') &&
        request.resource.data.ifsc is string && request.resource.data.ifsc.matches('^[A-Z]{4}0[A-Z0-9]{6}$') &&
        request.resource.data.updatedAt == request.time;
    }
    match /settings/checkout {
      // Signed-in shoppers can read the same configured delivery quote; only admins may write it.
      allow get: if isAdmin() || (request.auth != null && request.auth.token.phone_number is string);
      allow list: if false;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['enabled','shippingCharge','taxIncluded','updatedAt']) &&
        request.resource.data.enabled is bool &&
        request.resource.data.taxIncluded == true &&
        request.resource.data.shippingCharge is int &&
        request.resource.data.shippingCharge >= 0 &&
        request.resource.data.shippingCharge <= 100000 &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
